-- Function to Handle Particle/Effect Hiding
local function UpdateParticleVisibility()
    -- Atmosphere & Clouds
    local Atm = Lighting:FindFirstChild("Atmosphere")
    if Atm then Atm.Density = Settings.HideParticles and 0 or 0.3 end -- Default density approx
    
    local Cld = Lighting:FindFirstChild("Clouds")
    if Cld then Cld.Cover = Settings.HideParticles and 0 or 0.5 end

    -- Global Shadows
    if Settings.HideParticles then Lighting.GlobalShadows = false else Lighting.GlobalShadows = true end

    -- Iterate Workspace for Particles/Trails
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") then
            obj.Enabled = not Settings.HideParticles
        end
        if obj:IsA("PointLight") or obj:IsA("SpotLight") then
            obj.Enabled = not Settings.HideParticles
        end
    end
end

-- Function to Handle Vehicle/Object Hiding (Visual Only)
local function UpdateVehicleVisibility()
    for _, obj in pairs(Workspace:GetDescendants()) do
        -- Kita gunakan LocalTransparencyModifier agar client-side only
        if obj:IsA("BasePart") then
            -- Cek apakah bagian ini adalah bagian dari Karakter Player
            local isPlayerPart = obj:IsDescendantOf(Character)
            
            if not isPlayerPart then
                -- Jika HideVehicles aktif, buat transparan total (1)
                -- Jika tidak aktif, kembalikan ke 0
                obj.LocalTransparencyModifier = Settings.HideVehicles and 1 or 0
            end
        end
    end
end

