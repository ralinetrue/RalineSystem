local function SetVisibility(Character, Visible)
    pcall(function()
        for _,Obj in pairs(Character:GetDescendants()) do
            if Obj:IsA("BasePart") then Obj.LocalTransparencyModifier = Visible and 0 or 1 end
            if Obj:IsA("Decal") then Obj.Transparency = Visible and 0 or 1 end
            if Obj:IsA("GuiObject") then Obj.Visible = Visible end
        end
    end)
end

