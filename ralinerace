--====================================================
-- ESP
--====================================================

local function CreateESP(player, character)
    if character:FindFirstChild("RalineESP") then return end

    local highlight = Instance.new("Highlight")
highlight.Name = "RalineESP"
highlight.FillTransparency = 0.5
highlight.OutlineTransparency = 0

if player.Team ~= nil and LocalPlayer.Team ~= nil then
    if player.Team == LocalPlayer.Team then
        highlight.FillColor = Color3.fromRGB(0, 170, 255) -- Biru
        highlight.OutlineColor = Color3.fromRGB(0, 255, 255)
    else
        highlight.FillColor = Color3.fromRGB(255, 0, 0) -- Merah
        highlight.OutlineColor = Color3.fromRGB(255, 100, 100)
    end
else
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.OutlineColor = Color3.fromRGB(255, 100, 100)
end

highlight.Parent = character

    local head = character:FindFirstChild("Head")
    local hrp = character:FindFirstChild("HumanoidRootPart")

    if head and hrp then
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "RalineESP"
        billboard.Size = UDim2.new(0, 200, 0, 70)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = head

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextScaled = false
        label.TextSize = 14
        label.Font = Enum.Font.SourceSansBold
        label.TextStrokeTransparency = 0
        label.TextColor3 = Color3.new(1, 1, 1)
        label.Parent = billboard

        task.spawn(function()
            while ESPEnabled and character.Parent and billboard.Parent do
                local vel = hrp.AssemblyLinearVelocity

                local speed = math.floor(
                    Vector3.new(vel.X, 0, vel.Z).Magnitude
                )

                local jump = math.floor(vel.Y)

                label.Text =
                    player.Name ..
                    "\nSPD: " .. speed ..
                    " | JMP: " .. jump

                task.wait(0.1)
            end
        end)
    end
end

RaceTab:CreateToggle({
   Name = "📦 ESP (Name & Box)",
   CurrentValue = false,

   Callback = function(Value)

      ESPEnabled = Value

      if Value then

         for _, player in pairs(Players:GetPlayers()) do
    if player ~= LocalPlayer and player.Character then
        CreateESP(player, player.Character)
    end
end

      else

         for _, v in pairs(workspace:GetDescendants()) do

            if v.Name == "RalineESP" then
               v:Destroy()
            end

         end
      end
   end,
})

