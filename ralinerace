-- Listener untuk Object Baru
Workspace.DescendantAdded:Connect(function(obj)
    -- Handle Particles
    if Settings.HideParticles then
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("PointLight") or obj:IsA("SpotLight") then
            obj.Enabled = false
        end
        if obj:IsA("Atmosphere") then obj.Density = 0 end
        if obj:IsA("Clouds") then obj.Cover = 0 end
    end

    -- Handle Vehicles (Deteksi Baru)
    -- Jika objek adalah Model dan punya Seat
    if obj:IsA("Model") and obj ~= Character then
        local seat = GetVehicleSeat(obj)
        if seat then
            KnownVehicles[obj] = seat
            
            -- Terapkan visibilitas langsung
            if Settings.HideVehicles then
                SetModelTransparency(obj, true) -- Default hidden
            end
        end
    end
    
    -- Jika objek adalah Seat yang ditambahkan ke Model yang sudah ada
    if obj:IsA("VehicleSeat") or obj:IsA("Seat") then
        local parentModel = obj:FindFirstAncestorOfClass("Model")
        if parentModel and parentModel ~= Character and not KnownVehicles[parentModel] then
            KnownVehicles[parentModel] = obj
            if Settings.HideVehicles then
                SetModelTransparency(parentModel, true)
            end
        end
    end
end)

