-- Function: Cek apakah Model ini kendaraan (Deep Scan Seat)
local function GetVehicleSeat(Model)
    return Model:FindFirstChildOfClass("VehicleSeat") or Model:FindFirstChildOfClass("Seat")
end

-- Function: Set transparansi model
local function SetModelTransparency(Model, IsHidden)
    for _, Part in pairs(Model:GetDescendants()) do
        if Part:IsA("BasePart") then
            Part.LocalTransparencyModifier = IsHidden and 1 or 0
        end
    end
end

-- Function: Handle Particles
local function UpdateParticleVisibility()
    local Atm = Lighting:FindFirstChild("Atmosphere")
    if Atm then Atm.Density = Settings.HideParticles and 0 or 0.3 end
    
    local Cld = Lighting:FindFirstChild("Clouds")
    if Cld then Cld.Cover = Settings.HideParticles and 0 or 0.5 end

    Lighting.GlobalShadows = not Settings.HideParticles

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") then
            obj.Enabled = not Settings.HideParticles
        end
        if obj:IsA("PointLight") or obj:IsA("SpotLight") then
            obj.Enabled = not Settings.HideParticles
        end
    end
end

-- Variable untuk menyimpan referensi kendaraan agar tidak scan ulang terus menerus
local KnownVehicles = {}

-- Function: Handle Vehicles (Check Occupant)
local function UpdateVehicleVisibility()
    for model, seat in pairs(KnownVehicles) do
        if model and model.Parent and seat and seat.Parent then
            local shouldHide = false
            
            if Settings.HideVehicles then
                -- Default: Sembunyikan
                shouldHide = true
                
                -- Exception: Jika saya yang duduk (Occupant adalah Humanoid saya)
                if seat.Occupant then
                    if seat.Occupant.Parent == Character then
                        shouldHide = false -- Tampilkan jika saya yang pakai
                    end
                end
            end
            
            SetModelTransparency(model, shouldHide)
        else
            -- Hapus dari cache jika sudah tidak ada
            KnownVehicles[model] = nil
        end
    end
end

