-- Create ESP Elements
local function CreateESP(PlayerObj)
    if PlayerObj == LocalPlayer then return end
    local function Setup(Char)
        pcall(function()
            if ESPObjects[PlayerObj] then for _,l in pairs(ESPObjects[PlayerObj]) do l:Destroy() end end
            local Head = Char:FindFirstChild("Head")
            local HRP = Char:FindFirstChild("HumanoidRootPart")
            if not Head or not HRP then return end

            -- Highlight Box
            local Highlight = Instance.new("Highlight", Char)
            Highlight.Name = "ESP_Raline"
            Highlight.FillTransparency = 0.5
            Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

            -- Text UI
            local UI = Instance.new("BillboardGui", Head)
            UI.AlwaysOnTop = true
            UI.Size = UDim2.new(0,200,0,50)
            UI.StudsOffset = Vector3.new(0,2,0)
            local Label = Instance.new("TextLabel", UI)
            Label.BackgroundTransparency = 1
            Label.Size = UDim2.new(1,0,1,0)
            Label.Font = Enum.Font.GothamBold
            -- Ubah TextScaled jadi false agar kita bisa kontrol TextSize
            Label.TextScaled = false 
            Label.TextSize = Settings.ESP.TextSize 
            Label.TextStrokeTransparency = 0

            ESPObjects[PlayerObj] = {Highlight=Highlight, Text=UI, Label=Label}
        end)
    end
    if PlayerObj.Character then Setup(PlayerObj.Character) end
    PlayerObj.CharacterAdded:Connect(Setup)
end
for _,v in pairs(Players:GetPlayers()) do CreateESP(v) end
Players.PlayerAdded:Connect(CreateESP)

