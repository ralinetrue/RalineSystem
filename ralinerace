--====================================================
-- 🔄 MAIN SYSTEM LOOP
--====================================================
local LastTime = tick()
local FrameCount = 0

RunService.RenderStepped:Connect(function()
    -- FPS Counter
    local currentTime = tick()
    FrameCount = FrameCount + 1
    if currentTime - LastTime >= 1 then
        local fps = math.floor(FrameCount / (currentTime - LastTime))
        local ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        FPS_Display:Set({Title = "FPS", Content = tostring(fps)})
        Ping_Display:Set({Title = "Ping", Content = tostring(ping).." ms"})
        LastTime = currentTime
        FrameCount = 0
    end

    if not Character or not Humanoid or not RootPart then return end

    -- 🚀 SPEED & JUMP LOGIC
    pcall(function()
        Humanoid.WalkSpeed = Settings.Speed.Enabled and Settings.Speed.Value or 16
        Humanoid.JumpPower = Settings.Jump.Enabled and Settings.Jump.Value or 50
    end)

    -- 👻 NOCLIP LOGIC
    if Settings.Noclip then
        pcall(function() for _,b in pairs(Character:GetDescendants()) do if b:IsA("BasePart") then b.CanCollide=false end end end)
    end

    -- 📷 CAMERA LOGIC
    if Settings.Camera.Enabled then LocalPlayer.CameraMaxZoomDistance = Settings.Camera.Value end

    -- 🎯 CROSSHAIR LOGIC
    for _,g in pairs(Crosshair) do g.Visible = Settings.Crosshair end

    -- 📦 ESP LOGIC
    if Settings.ESP.Main then
        for PlayerObj, Data in pairs(ESPObjects) do
            pcall(function()
                local TargetChar = PlayerObj.Character
                if not TargetChar or not TargetChar:FindFirstChild("HumanoidRootPart") then Data.Highlight.Enabled=false Data.Text.Enabled=false return end
                local TargetHRP = TargetChar.HumanoidRootPart

                -- Calculate Real-Time Data
                local Distance = math.floor((RootPart.Position - TargetHRP.Position).Magnitude)
                local RealSpeed = math.floor(Vector3.new(TargetHRP.Velocity.X,0,TargetHRP.Velocity.Z).Magnitude)
                local RealJump = math.floor(TargetHRP.Velocity.Y)

                -- 🎨 COLOR RULES
                if Settings.ESP.TeamColor and PlayerObj.Team and LocalPlayer.Team then
                    if PlayerObj.Team == LocalPlayer.Team then
                        Data.Highlight.OutlineColor = Color3.fromRGB(0, 150, 255)
                        Data.Label.TextColor3 = Color3.fromRGB(0, 200, 255)
                    else
                        Data.Highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
                        Data.Label.TextColor3 = Color3.fromRGB(255, 80, 80)
                    end
                else
                    Data.Highlight.OutlineColor = Color3.fromRGB(255, 255, 0)
                    Data.Label.TextColor3 = Color3.fromRGB(255, 255, 0)
                end

                -- ✅ ENABLE FEATURES
                Data.Highlight.Enabled = Settings.ESP.Box
                Data.Text.Enabled = Settings.ESP.Name or Settings.ESP.Distance or Settings.ESP.SpeedJump

                -- 📝 BUILD TEXT
                local Text = ""
                if Settings.ESP.Name then Text = Text..PlayerObj.Name.." " end
                if Settings.ESP.Distance then Text = Text.."| "..Distance.."m " end
                if Settings.ESP.SpeedJump then Text = Text.."| SPD:"..RealSpeed.." JMP:"..RealJump end

                Data.Label.Text = Text
                -- Update TextSize secara real-time
                Data.Label.TextSize = Settings.ESP.TextSize
            end)
        end
    else
        for _,Data in pairs(ESPObjects) do pcall(function() Data.Highlight.Enabled=false Data.Text.Enabled=false end) end
    end

end)
