local function CreateLine(size, pos)

    local frame = Instance.new("Frame")

    frame.BackgroundColor3 = Color3.new(1,1,1)
    frame.BorderSizePixel = 0
    frame.AnchorPoint = Vector2.new(0.5,0.5)
    frame.Position = pos
    frame.Size = size
    frame.Visible = false
    frame.Parent = CrosshairGui

    return frame

end

