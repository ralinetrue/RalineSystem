--====================================================
-- FREECAM FUNCTIONS
--====================================================

local function EnableFreecam()
    if FreecamEnabled then return end
    FreecamEnabled = true

    local Character = LocalPlayer.Character

    if Character then
        local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
        local Humanoid = Character:FindFirstChild("Humanoid")

        if HumanoidRootPart then
            SavedCFrame = HumanoidRootPart.CFrame
        end

        if Humanoid then
            Humanoid.WalkSpeed = 0
            Humanoid.JumpPower = 0
            Humanoid.AutoRotate = false
        end
    end

    Camera.CameraType = Enum.CameraType.Scriptable
    UIS.MouseBehavior = Enum.MouseBehavior.LockCenter

    CameraPosition = Camera.CFrame.Position
    TargetPosition = Camera.CFrame.Position

    local _, Yaw, _ = Camera.CFrame:ToOrientation()
    CameraYaw = math.deg(Yaw)
    CameraPitch = 0

    FreecamConnection = RunService.RenderStepped:Connect(function(Delta)

        local Character = LocalPlayer.Character

        if Character and Character:FindFirstChild("HumanoidRootPart") and SavedCFrame then
            Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
            Character.HumanoidRootPart.AssemblyAngularVelocity = Vector3.zero
            Character.HumanoidRootPart.CFrame = SavedCFrame
        end

        local MouseDelta = UIS:GetMouseDelta()

        CameraYaw -= MouseDelta.X * 0.25
        CameraPitch = math.clamp(CameraPitch - MouseDelta.Y * 0.25, -89, 89)

        local Rotation = CFrame.fromOrientation(
            math.rad(CameraPitch),
            math.rad(CameraYaw),
            0
        )

        local Direction = Vector3.zero
        Direction += Rotation.LookVector * MoveForward
        Direction += Rotation.RightVector * MoveSide
        Direction += Vector3.new(0,1,0) * MoveVertical

        local Speed = CameraSpeed * 16

        TargetPosition += Direction * Speed * Delta
        CameraPosition = CameraPosition:Lerp(TargetPosition, 0.20)

        local SmoothCFrame = CFrame.new(CameraPosition) * Rotation

        Camera.CFrame = Camera.CFrame:Lerp(SmoothCFrame, 0.22)
    end)

    Rayfield:Notify({
        Title = "Free Camera",
        Content = "Enabled",
        Duration = 2
    })
end

local function DisableFreecam()
    if not FreecamEnabled then return end
    FreecamEnabled = false

    if FreecamConnection then
        FreecamConnection:Disconnect()
        FreecamConnection = nil
    end

    UIS.MouseBehavior = Enum.MouseBehavior.Default
    Camera.CameraType = Enum.CameraType.Custom

    local Character = LocalPlayer.Character
    if Character then
        local Humanoid = Character:FindFirstChild("Humanoid")
        if Humanoid then
            Humanoid.WalkSpeed = 16
            Humanoid.JumpPower = 50
            Humanoid.AutoRotate = true
            Camera.CameraSubject = Humanoid
        end
    end

    Rayfield:Notify({
        Title = "Free Camera",
        Content = "Disabled",
        Duration = 2
    })
end

--====================================================
-- INPUT MOVEMENT
--====================================================

UIS.InputBegan:Connect(function(Input, GPE)
    if GPE then return end

    -- FREECAM MOVE
    if Input.KeyCode == Enum.KeyCode.W then MoveForward = 1 end
    if Input.KeyCode == Enum.KeyCode.S then MoveForward = -1 end
    if Input.KeyCode == Enum.KeyCode.A then MoveSide = -1 end
    if Input.KeyCode == Enum.KeyCode.D then MoveSide = 1 end
    if Input.KeyCode == Enum.KeyCode.Q then MoveVertical = -1 end
    if Input.KeyCode == Enum.KeyCode.E then MoveVertical = 1 end

    -- FREECAM TOGGLE F
    if Input.KeyCode == Enum.KeyCode.F then
        if FreecamEnabled then
            DisableFreecam()
            if FreecamToggle then FreecamToggle:Set(false) end
        else
            EnableFreecam()
            if FreecamToggle then FreecamToggle:Set(true) end
        end
    end

    --====================================================
    -- 🔥 TAP TAP SHORTCUT (T)
    --====================================================
    if Input.KeyCode == Enum.KeyCode.T then

        TapTapEnabled = not TapTapEnabled

        if TapTapEnabled then

            if not TapTapPosition then
                Rayfield:Notify({
                    Title = "Tap Tap",
                    Content = "Select Position First",
                    Duration = 3
                })
                TapTapEnabled = false
                return
            end

            if not TapTapConnection then
                TapTapConnection = RunService.RenderStepped:Connect(function()
                    VIM:SendMouseButtonEvent(TapTapPosition.X, TapTapPosition.Y, 0, true, game, 1)
                    VIM:SendMouseButtonEvent(TapTapPosition.X, TapTapPosition.Y, 0, false, game, 1)
                end)
            end

            Rayfield:Notify({
                Title = "Tap Tap",
                Content = "Enabled (T)",
                Duration = 2
            })

        else

            if TapTapConnection then
                TapTapConnection:Disconnect()
                TapTapConnection = nil
            end

            Rayfield:Notify({
                Title = "Tap Tap",
                Content = "Disabled (T)",
                Duration = 2
            })
        end
    end
end)

UIS.InputEnded:Connect(function(Input)
    if Input.KeyCode == Enum.KeyCode.W or Input.KeyCode == Enum.KeyCode.S then MoveForward = 0 end
    if Input.KeyCode == Enum.KeyCode.A or Input.KeyCode == Enum.KeyCode.D then MoveSide = 0 end
    if Input.KeyCode == Enum.KeyCode.Q or Input.KeyCode == Enum.KeyCode.E then MoveVertical = 0 end
end)

